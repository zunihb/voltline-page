---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import WorkShowcase from '../components/WorkShowcase.astro';
import TrustedSection from '../components/TrustedSection.astro';
import MissionVision from '../components/MissionVision.astro';
import WhatWeDo from '../components/WhatWeDo.astro';
import ServicesBoard from '../components/ServicesBoard.astro';
import MidCTA from '../components/MidCTA.astro';
import ValuePanels from '../components/ValuePanels.astro';
import FinalNarrative from '../components/FinalNarrative.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n/utils';

const lang = 'es' as const;
---

<Layout title={t(lang, 'site.title')} lang={lang}>
  <Navbar lang={lang} />
  <main id="main-content">
    <Hero lang={lang} />
    <WorkShowcase lang={lang} />
    <TrustedSection lang={lang} />
    <MissionVision lang={lang} />
    <WhatWeDo lang={lang} />
    <ServicesBoard lang={lang} />
    <MidCTA lang={lang} />
    <ValuePanels lang={lang} />
    <FinalNarrative lang={lang} />
    <CTASection lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
