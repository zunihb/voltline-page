---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import WorkShowcase from '../components/WorkShowcase.astro';
import TrustedSection from '../components/TrustedSection.astro';
import MissionVision from '../components/MissionVision.astro';
import WhatWeDo from '../components/WhatWeDo.astro';
import ServicesBoard from '../components/ServicesBoard.astro';
import MidCTA from '../components/MidCTA.astro';
import ValuePanels from '../components/ValuePanels.astro';
import FinalNarrative from '../components/FinalNarrative.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="LiveElectric | Seguridad operacional para lineas vivas">
  <Navbar />
  <main id="main-content">
    <Hero />
    <WorkShowcase />
    <TrustedSection />
    <MissionVision />
    <WhatWeDo />
    <ServicesBoard />
    <MidCTA />
    <ValuePanels />
    <FinalNarrative />
    <CTASection />
  </main>
  <Footer />
</Layout>
