---
import '../styles/global.css';
import type { Lang } from '../i18n/translations';
import { t, getAlternateUrl } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}

const {
  title,
  lang = 'es',
  description = t(lang, 'site.description'),
} = Astro.props;

const altUrl = getAlternateUrl(lang);
const altLang = lang === 'es' ? 'en' : 'es';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang={altLang} href={altUrl} />
    <link rel="alternate" hreflang={lang} href={lang === 'es' ? '/' : '/en/'} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t(lang, 'site.skipLink')}</a>
    <slot />

    <script>
      /* ── Auto-detect language on root page ── */
      (function () {
        const path = window.location.pathname;
        if (path !== '/' && path !== '/index.html') return;
        const stored = localStorage.getItem('le-lang');
        if (stored === 'es' || stored === 'en') return;
        const browserLang = navigator.language?.slice(0, 2);
        if (browserLang === 'en') {
          localStorage.setItem('le-lang', 'en');
          window.location.replace('/en/');
        } else {
          localStorage.setItem('le-lang', 'es');
        }
      })();

      /* ── Scroll-reveal observer ── */
      const revealEls = document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale');
      if (revealEls.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      }

      /* ── Navbar scroll glassmorphism ── */
      const nav = document.querySelector('nav');
      if (nav) {
        const onScroll = () => {
          nav.classList.toggle('nav-scrolled', window.scrollY > 40);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      /* ── Counter animation ── */
      const counters = document.querySelectorAll('[data-counter]');
      if (counters.length) {
        const cio = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              const el = e.target as HTMLElement;
              const final = el.dataset.counter || '0';
              const isPercent = final.includes('%');
              const hasSlash = final.includes('/');
              const num = parseFloat(final.replace(/[^0-9.]/g, ''));
              const duration = 1600;
              const start = performance.now();

              const tick = (now: number) => {
                const t = Math.min((now - start) / duration, 1);
                const ease = 1 - Math.pow(1 - t, 4);
                const current = Math.round(ease * num * 10) / 10;

                if (hasSlash) {
                  el.textContent = `${Math.round(ease * 24)}/${Math.round(ease * 7)}`;
                } else if (isPercent) {
                  el.textContent = `${Math.round(current)}%`;
                } else {
                  el.textContent = String(Math.round(current));
                }

                if (t < 1) {
                  requestAnimationFrame(tick);
                } else {
                  el.textContent = final;
                  el.classList.add('counter-done');
                }
              };
              requestAnimationFrame(tick);
              cio.unobserve(el);
            });
          },
          { threshold: 0.5 }
        );
        counters.forEach((el) => cio.observe(el));
      }
    </script>
  </body>
</html>
