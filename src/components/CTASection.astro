---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
---

<section id="contact" class="py-16 md:py-20 lg:py-24">
  <div class="container-shell">
    <div class="reveal-scale relative overflow-hidden rounded-3xl bg-gradient-to-br from-primary-dark via-primary to-signal px-6 py-14 text-white shadow-2xl md:px-14 md:py-16">
      <div class="absolute -left-12 top-1/2 h-44 w-44 -translate-y-1/2 rounded-full bg-accent/30 blur-3xl float-slow"></div>
      <div class="absolute right-6 top-6 h-24 w-24 rounded-full border border-white/25 float-medium"></div>
      <div class="relative max-w-3xl">
        <p class="eyebrow text-cyan-100">{t(lang, 'cta.eyebrow')}</p>
        <h2 class="mt-3 font-display text-5xl leading-[0.92] text-white md:text-6xl">{t(lang, 'cta.title')}</h2>
        <p class="mt-6 text-base text-slate-100 md:text-lg">{t(lang, 'cta.copy')}</p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="mailto:contacto@liveelectric.app" class="btn-glow rounded-xl bg-accent px-8 py-4 text-base font-bold uppercase tracking-wide text-white">{t(lang, 'cta.button')}</a>
          <span class="text-sm text-slate-100">{t(lang, 'cta.note')}</span>
        </div>
      </div>
    </div>
  </div>
</section>
