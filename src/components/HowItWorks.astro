---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const steps = [
  { number: '01', title: t(lang, 'hiw.s1.title'), description: t(lang, 'hiw.s1.desc') },
  { number: '02', title: t(lang, 'hiw.s2.title'), description: t(lang, 'hiw.s2.desc') },
  { number: '03', title: t(lang, 'hiw.s3.title'), description: t(lang, 'hiw.s3.desc') },
];
---

<section id="how-it-works" class="py-20">
  <div class="container-shell">
    <p class="reveal eyebrow">{t(lang, 'hiw.eyebrow')}</p>
    <h2 class="reveal section-title mt-3 max-w-3xl" style="transition-delay:80ms">{t(lang, 'hiw.title')}</h2>
    <div class="relative mt-12 grid gap-6 md:grid-cols-3">
      <div class="pointer-events-none absolute left-[15%] right-[15%] top-[88px] hidden border-t border-dashed border-slate-300 md:block"></div>
      {steps.map((step, i) => (
        <article class="reveal card-surface card-hover relative p-7" style={`transition-delay: ${i * 150}ms`}>
          <p class="font-display text-7xl leading-none text-primary/10">{step.number}</p>
          <h3 class="mt-2 font-display text-3xl leading-none text-dark">{step.title}</h3>
          <p class="mt-4 text-sm leading-relaxed text-slate-600">{step.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
