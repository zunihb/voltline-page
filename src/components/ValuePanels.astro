---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const values = [
  { title: t(lang, 'vp.v1.title'), copy: t(lang, 'vp.v1.copy') },
  { title: t(lang, 'vp.v2.title'), copy: t(lang, 'vp.v2.copy') },
  { title: t(lang, 'vp.v3.title'), copy: t(lang, 'vp.v3.copy') },
];
---

<section class="py-16 md:py-20 lg:py-24">
  <div class="container-shell grid gap-8 lg:grid-cols-[1fr_1fr]">
    <article class="reveal-left rounded-2xl border border-slate-200 bg-white p-7 shadow-card md:p-8">
      <div class="overflow-hidden rounded-xl border border-slate-200">
        <img src="/media/bucket-desert.jpg" alt={t(lang, 'vp.imgAlt')} width="1024" height="1536" loading="lazy" decoding="async" class="h-60 w-full object-cover object-center" />
      </div>
      <p class="eyebrow mt-6">{t(lang, 'vp.eyebrow')}</p>
      <h2 class="mt-3 font-display text-5xl leading-[0.92] text-dark lg:text-6xl">{t(lang, 'vp.title')}</h2>
      <p class="mt-5 text-sm leading-relaxed text-slate-600 md:text-base">{t(lang, 'vp.copy')}</p>
      <a href="#contact" class="mt-7 inline-flex rounded-xl bg-dark px-5 py-3 text-sm font-semibold text-white transition hover:bg-dark-light">{t(lang, 'vp.cta')}</a>
    </article>
    <div class="space-y-4">
      {values.map((item, i) => (
        <article class="reveal-right card-hover rounded-2xl border border-slate-200 bg-surface p-7 shadow-sm md:p-8" style={`transition-delay: ${i * 120}ms`}>
          <div class="flex items-start gap-4">
            <span class="mt-1 inline-flex h-7 w-7 flex-none items-center justify-center rounded-full border border-slate-300 text-xs font-semibold text-slate-600">+</span>
            <div>
              <h3 class="font-display text-3xl leading-none text-dark">{item.title}</h3>
              <p class="mt-4 text-sm leading-relaxed text-slate-600 md:text-[15px]">{item.copy}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
