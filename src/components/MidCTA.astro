---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
---

<section class="relative overflow-hidden bg-dark py-16 text-white md:py-20">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_15%_50%,rgba(245,158,11,0.35),transparent_45%),radial-gradient(circle_at_80%_50%,rgba(59,130,246,0.3),transparent_45%)]"></div>
  <div class="absolute inset-0 bg-mesh-grid bg-[size:40px_40px] opacity-15"></div>
  <div class="container-shell relative text-center">
    <p class="reveal eyebrow text-cyan-100">{t(lang, 'midcta.eyebrow')}</p>
    <h2 class="reveal mt-4 font-display text-5xl leading-[0.95] md:text-6xl" style="transition-delay:100ms">{t(lang, 'midcta.title')}</h2>
    <div class="reveal mt-8 flex flex-wrap items-center justify-center gap-4" style="transition-delay:200ms">
      <a href="#contact" class="btn-glow rounded-xl bg-accent px-6 py-3 text-sm font-bold uppercase tracking-wide text-white">{t(lang, 'midcta.cta')}</a>
      <a href="#services" class="rounded-xl border border-white/35 px-6 py-3 text-sm font-bold uppercase tracking-wide text-white transition hover:bg-white/10">{t(lang, 'midcta.secondary')}</a>
    </div>
  </div>
</section>
