---
import type { McpLang } from '../../lib/mcp';
import { mcpBase } from '../../lib/mcp';
interface Props { lang: McpLang; }
const { lang } = Astro.props;
const base = mcpBase(lang);
const privacy = lang === 'es' ? '/politica-de-privacidad' : '/en/privacy-policy';
const copy = lang === 'es'
  ? { line: 'Herramientas seguras para operación eléctrica.', auth: 'Autenticación', security: 'Seguridad', privacy: 'Privacidad', trouble: 'Ayuda', status: 'Piloto por invitación' }
  : { line: 'Secure tools for electrical operations.', auth: 'Authentication', security: 'Security', privacy: 'Privacy', trouble: 'Help', status: 'Invitation-only pilot' };
---

<footer class="border-t border-white/10 bg-dark py-10 text-slate-400">
  <div class="container-shell">
    <div class="flex flex-col gap-7 md:flex-row md:items-end md:justify-between">
      <div>
        <a class="font-display text-2xl font-semibold uppercase tracking-industrial text-white" href={base}>Voltline MCP</a>
        <p class="mt-2 max-w-sm text-sm leading-relaxed">{copy.line}</p>
        <span class="mt-4 inline-flex items-center gap-2 rounded-full border border-cyan-300/20 bg-cyan-300/10 px-3 py-1.5 text-xs font-semibold text-cyan-200"><span class="h-1.5 w-1.5 rounded-full bg-cyan-300"></span>{copy.status}</span>
      </div>
      <nav class="flex max-w-lg flex-wrap gap-x-5 gap-y-3 text-sm" aria-label="MCP footer">
        <a class="hover:text-white" href={`${base}/${lang === 'es' ? 'autenticacion' : 'authentication'}`}>{copy.auth}</a>
        <a class="hover:text-white" href={`${base}/${lang === 'es' ? 'seguridad' : 'security'}`}>{copy.security}</a>
        <a class="hover:text-white" href={privacy}>{copy.privacy}</a>
        <a class="hover:text-white" href={`${base}/${lang === 'es' ? 'solucion-de-problemas' : 'troubleshooting'}`}>{copy.trouble}</a>
        <a class="hover:text-white" href="mailto:contacto@voltline.cl">contacto@voltline.cl</a>
      </nav>
    </div>
    <p class="mt-8 border-t border-white/10 pt-6 text-xs uppercase tracking-industrial text-slate-500">© {new Date().getFullYear()} Voltline</p>
  </div>
</footer>
