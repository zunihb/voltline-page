---
import type { McpLang } from '../../lib/mcp';
import { mcpBase } from '../../lib/mcp';

interface Props { lang: McpLang; alternatePath: string; }
const { lang, alternatePath } = Astro.props;
const base = mcpBase(lang);
const labels = lang === 'es'
  ? { docs: 'Herramientas', security: 'Seguridad', support: 'Soporte', pilot: 'Solicitar piloto', menu: 'Abrir menú', language: 'EN' }
  : { docs: 'Tools', security: 'Security', support: 'Support', pilot: 'Request pilot', menu: 'Open menu', language: 'ES' };
---

<nav class="sticky top-0 z-50 border-b border-white/10 bg-dark/90 backdrop-blur-xl" aria-label="MCP">
  <div class="container-shell flex h-[72px] items-center justify-between gap-3">
    <a href={base} class="inline-flex min-w-0 items-center gap-3">
      <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-accent/40 bg-accent/10">
        <svg class="h-5 w-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M13 2 3 14h8.5L10 22l11-13h-8.5z" /></svg>
      </span>
      <span class="min-w-0">
        <span class="block truncate font-display text-xl font-semibold uppercase tracking-industrial text-white">Voltline MCP</span>
        <span class="block text-[10px] uppercase tracking-[0.18em] text-slate-400">Piloto controlado</span>
      </span>
    </a>

    <div class="hidden items-center gap-6 text-sm font-semibold text-slate-300 md:flex">
      <a class="transition hover:text-white" href={`${base}/docs`}>{labels.docs}</a>
      <a class="transition hover:text-white" href={`${base}/${lang === 'es' ? 'seguridad' : 'security'}`}>{labels.security}</a>
      <a class="transition hover:text-white" href={`${base}/${lang === 'es' ? 'soporte' : 'support'}`}>{labels.support}</a>
      <a class="rounded-lg border border-white/15 px-3 py-2 text-xs text-white transition hover:border-white/35" href={alternatePath}>{labels.language}</a>
      <a class="rounded-xl bg-accent px-4 py-2.5 text-dark transition hover:bg-accent-light" href="mailto:contacto@voltline.cl?subject=Piloto%20MCP%20Voltline">{labels.pilot}</a>
    </div>

    <details class="relative md:hidden">
      <summary class="grid h-11 w-11 cursor-pointer place-items-center rounded-xl border border-white/20 bg-white/5 text-white [&::-webkit-details-marker]:hidden" aria-label={labels.menu}>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </summary>
      <div class="absolute right-0 mt-3 w-64 rounded-2xl border border-white/10 bg-dark-light p-3 text-sm font-semibold text-slate-200 shadow-2xl">
        <a class="block rounded-lg px-3 py-2 hover:bg-white/10" href={`${base}/docs`}>{labels.docs}</a>
        <a class="mt-1 block rounded-lg px-3 py-2 hover:bg-white/10" href={`${base}/${lang === 'es' ? 'seguridad' : 'security'}`}>{labels.security}</a>
        <a class="mt-1 block rounded-lg px-3 py-2 hover:bg-white/10" href={`${base}/${lang === 'es' ? 'soporte' : 'support'}`}>{labels.support}</a>
        <a class="mt-1 block rounded-lg px-3 py-2 hover:bg-white/10" href={alternatePath}>{labels.language}</a>
        <a class="mt-3 block rounded-lg bg-accent px-3 py-2.5 text-center text-dark" href="mailto:contacto@voltline.cl?subject=Piloto%20MCP%20Voltline">{labels.pilot}</a>
      </div>
    </details>
  </div>
</nav>
