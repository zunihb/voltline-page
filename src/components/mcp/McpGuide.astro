---
import type { Guide } from '../../lib/mcp-content';
import type { McpLang } from '../../lib/mcp';
import { mcpBase } from '../../lib/mcp';
interface Props { guide: Guide; lang: McpLang; }
const { guide, lang } = Astro.props;
const base = mcpBase(lang);
---

<section class="border-b border-white/10 bg-hero-glow py-14 sm:py-20"><div class="container-shell"><a class="text-xs font-bold text-accent" href={base}>← Voltline MCP</a><p class="eyebrow mt-7 text-accent">{guide.eyebrow}</p><h1 class="mt-3 max-w-4xl font-display text-5xl font-semibold uppercase leading-[.92] text-white sm:text-6xl">{guide.title}</h1><p class="mt-5 max-w-2xl text-sm leading-relaxed text-slate-300 sm:text-base">{guide.description}</p></div></section>
<div class="container-shell grid gap-4 py-10 sm:py-14 md:grid-cols-2">{guide.sections.map((section, index) => <section class:list={["rounded-2xl border border-white/10 bg-white/[.035] p-5 sm:p-7", section.code && 'md:col-span-2']}><span class="font-display text-4xl text-accent/30">0{index + 1}</span><h2 class="mt-3 font-display text-3xl font-semibold uppercase leading-none text-white">{section.title}</h2>{section.paragraphs?.map((paragraph) => <p class="mt-4 text-sm leading-relaxed text-slate-300">{paragraph}</p>)}{section.bullets && <ul class="mt-4 space-y-3 text-sm leading-relaxed text-slate-300">{section.bullets.map((bullet) => <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span><span>{bullet}</span></li>)}</ul>}{section.code && <pre class="mt-5 overflow-x-auto rounded-xl border border-white/10 bg-black/30 p-4 text-xs text-cyan-200"><code>{section.code}</code></pre>}</section>)}</div>
<section class="border-t border-white/10 bg-white/[.025] py-12"><div class="container-shell flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><p class="max-w-xl text-sm text-slate-400">{lang === 'es' ? '¿Necesitas ayuda con tu caso? Te recomendamos el alcance inicial más seguro.' : 'Need help with your use case? We will recommend the safest initial scope.'}</p><a class="rounded-xl bg-accent px-5 py-3 text-center text-sm font-bold text-dark" href="mailto:contacto@voltline.cl?subject=Piloto%20MCP%20Voltline">{lang === 'es' ? 'Hablar con Voltline' : 'Talk to Voltline'}</a></div></section>
