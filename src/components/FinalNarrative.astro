---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
---

<section class="bg-surface py-16 md:py-20 lg:py-24">
  <div class="container-shell grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
    <div class="reveal-left">
      <p class="eyebrow">{t(lang, 'fn.eyebrow')}</p>
      <h2 class="section-title mt-3">{t(lang, 'fn.title')}</h2>
      <div class="mt-8 grid grid-cols-3 gap-4">
        <article class="reveal rounded-xl border border-slate-200 bg-white p-4 text-center" style="transition-delay:200ms">
          <p class="font-display text-4xl text-primary" data-counter="24/7">24/7</p>
          <p class="mt-2 text-[11px] uppercase tracking-industrial text-slate-500">{t(lang, 'fn.stat1.label')}</p>
        </article>
        <article class="reveal rounded-xl border border-slate-200 bg-white p-4 text-center" style="transition-delay:320ms">
          <p class="font-display text-4xl text-primary" data-counter="100%">100%</p>
          <p class="mt-2 text-[11px] uppercase tracking-industrial text-slate-500">{t(lang, 'fn.stat2.label')}</p>
        </article>
        <article class="reveal rounded-xl border border-slate-200 bg-white p-4 text-center" style="transition-delay:440ms">
          <p class="font-display text-4xl text-primary" data-counter="0">0</p>
          <p class="mt-2 text-[11px] uppercase tracking-industrial text-slate-500">{t(lang, 'fn.stat3.label')}</p>
        </article>
      </div>
    </div>
    <article class="reveal-right rounded-2xl border border-slate-200 bg-white p-7 shadow-card md:p-8">
      <p class="eyebrow">{t(lang, 'fn.bizEyebrow')}</p>
      <h3 class="mt-3 font-display text-4xl leading-[0.92] text-dark md:text-5xl">{t(lang, 'fn.bizTitle')}</h3>
      <p class="mt-5 text-sm leading-relaxed text-slate-600 md:text-base">{t(lang, 'fn.bizCopy')}</p>
      <a href="#contact" class="mt-7 inline-flex rounded-xl bg-accent px-5 py-3 text-sm font-bold uppercase tracking-wide text-white transition hover:bg-accent-dark">{t(lang, 'fn.bizCta')}</a>
    </article>
  </div>
</section>
