---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const projects = [
  { title: t(lang, 'work.p1.title'), location: t(lang, 'work.p1.location'), image: '/media/technician-closeup.jpg', position: 'object-center' },
  { title: t(lang, 'work.p2.title'), location: t(lang, 'work.p2.location'), image: '/media/certification-bucket.jpg', position: 'object-center' },
  { title: t(lang, 'work.p3.title'), location: t(lang, 'work.p3.location'), image: '/media/field-overview.jpg', position: 'object-center' },
];
---

<section id="work" class="py-16 md:py-20 lg:py-24">
  <div class="container-shell">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="reveal eyebrow">{t(lang, 'work.eyebrow')}</p>
        <h2 class="reveal section-title mt-3" style="transition-delay:80ms">{t(lang, 'work.title')}</h2>
      </div>
      <a href="#contact" class="text-sm font-semibold uppercase tracking-wide text-primary transition hover:text-primary-dark">{t(lang, 'work.link')}</a>
    </div>

    <div class="mt-9 grid gap-5 md:mt-11 md:grid-cols-3">
      {projects.map((project, i) => (
        <article class="reveal group relative overflow-hidden rounded-2xl border border-slate-200 shadow-card" style={`transition-delay: ${i * 120}ms`}>
          <img src={project.image} alt={project.title} width="1024" height="1536" loading="lazy" decoding="async" class={`img-zoom h-72 w-full ${project.position} object-cover`} />
          <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_15%_15%,rgba(255,255,255,0.2),transparent_45%),radial-gradient(circle_at_80%_80%,rgba(15,23,42,0.38),transparent_55%)]"></div>
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/45 to-transparent p-5 text-white">
            <p class="text-xs uppercase tracking-industrial text-slate-200">{project.location}</p>
            <h3 class="mt-2 font-display text-[30px] leading-[0.92]">{project.title}</h3>
          </div>
          <div class="pointer-events-none absolute inset-0 ring-1 ring-white/0 transition group-hover:ring-white/60"></div>
        </article>
      ))}
    </div>
  </div>
</section>
