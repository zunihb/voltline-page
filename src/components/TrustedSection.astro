---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
---

<section class="bg-surface py-16 md:py-20 lg:py-24">
  <div class="container-shell grid gap-10 lg:grid-cols-[1fr_0.95fr] lg:items-center">
    <div class="reveal-left">
      <p class="eyebrow">{t(lang, 'trusted.eyebrow')}</p>
      <h2 class="section-title mt-3 max-w-xl">{t(lang, 'trusted.title')}</h2>
      <p class="section-copy max-w-xl">{t(lang, 'trusted.copy')}</p>
      <ul class="mt-7 space-y-3 text-sm text-slate-700 md:text-[15px]">
        <li class="flex items-start gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-primary"></span> {t(lang, 'trusted.bullet1')}</li>
        <li class="flex items-start gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-primary"></span> {t(lang, 'trusted.bullet2')}</li>
        <li class="flex items-start gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full bg-primary"></span> {t(lang, 'trusted.bullet3')}</li>
      </ul>
      <div class="mt-8 flex flex-wrap gap-3 text-[11px] uppercase tracking-industrial text-slate-600">
        <span class="rounded-full border border-slate-300 bg-white px-3 py-1">IEEE 516</span>
        <span class="rounded-full border border-slate-300 bg-white px-3 py-1">OSHA</span>
        <span class="rounded-full border border-slate-300 bg-white px-3 py-1">NFPA 70E</span>
        <span class="rounded-full border border-slate-300 bg-white px-3 py-1">IEC 60855</span>
      </div>
      <a href="#contact" class="mt-9 inline-flex rounded-xl bg-dark px-5 py-3 text-sm font-semibold text-white transition hover:bg-dark-light">{t(lang, 'trusted.cta')}</a>
    </div>
    <div class="reveal-right relative">
      <div class="absolute -left-6 -top-6 hidden h-24 w-24 rounded-full border border-primary/25 bg-primary/10 lg:block float-slow"></div>
      <div class="overflow-hidden rounded-2xl border border-slate-200 shadow-card">
        <img src="/media/remplazar.jpg" alt={t(lang, 'trusted.imgAlt')} width="1024" height="1536" loading="lazy" decoding="async" class="h-[360px] w-full object-cover object-top" />
      </div>
    </div>
  </div>
</section>
