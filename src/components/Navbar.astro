---
import type { Lang } from '../i18n/translations';
import { languages } from '../i18n/translations';
import { t, getAlternateUrl, getAlternateLang } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const altLang = getAlternateLang(lang);
const altUrl = getAlternateUrl(lang);
const base = lang === 'es' ? '' : '/en';
---

<nav class="sticky top-0 z-50 border-b border-slate-700/80 bg-dark shadow-[0_10px_28px_-18px_rgba(2,6,23,0.85)] transition-all duration-300" aria-label={t(lang, 'nav.ariaLabel')}>
  <div class="container-shell flex h-[84px] items-center justify-between gap-4">
    <a href={`${base}/#top`} class="group inline-flex items-center gap-3">
      <span class="grid h-10 w-10 place-items-center rounded-xl border border-white/25 bg-white/10 shadow-inset transition group-hover:border-accent/80">
        <svg class="h-5 w-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M13 2 3 14h8.5L10 22l11-13h-8.5z" />
        </svg>
      </span>
      <span>
        <span class="block font-display text-2xl font-semibold uppercase tracking-industrial text-white">LiveElectric</span>
        <span class="-mt-1 block text-[11px] uppercase tracking-[0.18em] text-slate-300">{t(lang, 'nav.tagline')}</span>
      </span>
    </a>

    <ul class="hidden items-center gap-8 text-sm font-semibold text-slate-100 md:flex">
      <li><a class="transition hover:text-accent focus-visible:rounded-md focus-visible:px-1" href={`${base}/#work`}>{t(lang, 'nav.work')}</a></li>
      <li><a class="transition hover:text-accent focus-visible:rounded-md focus-visible:px-1" href={`${base}/#services`}>{t(lang, 'nav.services')}</a></li>
      <li><a class="transition hover:text-accent focus-visible:rounded-md focus-visible:px-1" href={`${base}/#contact`}>{t(lang, 'nav.contact')}</a></li>
    </ul>

    <div class="hidden items-center gap-3 md:flex">
      <a
        href={altUrl}
        class="flex items-center gap-1.5 rounded-lg border border-white/20 px-3 py-2 text-xs font-semibold uppercase tracking-wide text-slate-200 transition hover:border-white/40 hover:text-white"
        data-lang-switch
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="10" />
          <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
        </svg>
        {languages[altLang]}
      </a>
      <a
        href={`${base}/#contact`}
        class="rounded-xl bg-accent px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-accent/35 transition hover:bg-accent-dark"
      >
        {t(lang, 'nav.cta')}
      </a>
    </div>

    <details class="relative md:hidden">
      <summary class="grid h-11 w-11 cursor-pointer place-items-center rounded-xl border border-white/30 bg-white/10 text-white [&::-webkit-details-marker]:hidden" aria-label={t(lang, 'nav.menuLabel')}>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </summary>
      <div class="absolute right-0 mt-3 w-60 rounded-2xl border border-slate-700 bg-dark-light/95 p-3 text-sm text-slate-100 shadow-2xl">
        <a href={`${base}/#work`} class="block rounded-lg px-3 py-2 hover:bg-slate-700/70">{t(lang, 'nav.work')}</a>
        <a href={`${base}/#services`} class="mt-1 block rounded-lg px-3 py-2 hover:bg-slate-700/70">{t(lang, 'nav.services')}</a>
        <a href={`${base}/#contact`} class="mt-1 block rounded-lg px-3 py-2 hover:bg-slate-700/70">{t(lang, 'nav.contact')}</a>
        <a href={altUrl} class="mt-1 flex items-center gap-2 rounded-lg px-3 py-2 hover:bg-slate-700/70" data-lang-switch>
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10" /><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
          {languages[altLang]}
        </a>
        <a href={`${base}/#contact`} class="mt-3 block rounded-lg bg-accent px-3 py-2 text-center font-semibold text-white">{t(lang, 'nav.cta')}</a>
      </div>
    </details>
  </div>
</nav>

<script>
  document.querySelectorAll('[data-lang-switch]').forEach((el) => {
    el.addEventListener('click', () => {
      const href = (el as HTMLAnchorElement).href;
      const isEn = href.includes('/en');
      localStorage.setItem('le-lang', isEn ? 'en' : 'es');
    });
  });
</script>
